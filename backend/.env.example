# Copia este archivo como backend/.env y completa tus datos.
# Spring Boot lee estas variables al iniciar (application.yaml importa ./backend/.env).

# Cuenta de correo que envía las entradas y códigos de verificación.
# Con Gmail: activa la verificación en dos pasos y usa una "contraseña de aplicación"
# de 16 caracteres (no la contraseña normal de la cuenta).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Servidor SMTP (Gmail por defecto).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Opcional: mostrar el código de verificación en la respuesta (solo desarrollo).
MAIL_EXPOSE_DEV_CODE=false
